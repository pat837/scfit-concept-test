# --- Backend (FastAPI / Render) ---
# Local Postgres for development; Render provides its own DATABASE_URL for production.
DATABASE_URL=postgresql://localhost:5432/scfit
# Use a long random value in production, e.g. generate one with: openssl rand -hex 32
ADMIN_API_KEY=replace-with-a-long-random-value
# Comma-separated list of allowed frontend origins (no trailing slash), e.g.:
# FRONTEND_ORIGIN=http://localhost:3000,https://scfit-concept-test.netlify.app
FRONTEND_ORIGIN=http://localhost:3000

# --- Frontend (Vite / Netlify) ---
# Origin only, no trailing slash. Leave as localhost for local dev; set to the
# deployed Render API origin (e.g. https://scfit-api.onrender.com) in Netlify.
VITE_API_BASE_URL=http://localhost:8000